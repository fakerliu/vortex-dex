# ============================================================
# VORTEX DEX 环境变量示例
# 复制为 .env 后按环境填写；.env 已被 .gitignore 忽略，严禁提交真实密钥
# ============================================================

# ---------- 应用环境 ----------
APP_ENV=local                # local | testnet | mainnet
PORT=3000                    # 前端端口
API_PORT=3001                # 后端端口
NEXT_PUBLIC_APP_ENV=local    # 前端运行时环境标识

# ---------- 链 / RPC ----------
# Base 主网
BASE_MAINNET_RPC_URL=https://mainnet.base.org
BASE_MAINNET_CHAIN_ID=8453
# Base Sepolia 测试网
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
BASE_SEPOLIA_CHAIN_ID=84532

# ---------- WalletConnect（前端钱包连接，敏感） ----------
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# ---------- 数据库 PostgreSQL ----------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=vortex
POSTGRES_PASSWORD=vortex     # 敏感：生产环境请使用强口令或密钥管理注入
POSTGRES_DB=vortex
DATABASE_URL=postgresql://vortex:vortex@localhost:5432/vortex?schema=public

# ---------- Redis ----------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=              # 敏感：本地可留空，生产必填
REDIS_URL=redis://localhost:6379

# ---------- 合约地址（部署后回填；勿编造、勿提交真实地址到仓库） ----------
CONTRACT_ROUTER_ADDRESS=
CONTRACT_FACTORY_ADDRESS=
CONTRACT_POOL_ADDRESS=

# ---------- 密钥（敏感，一律经密钥管理注入，禁止明文提交） ----------
DEPLOYER_PRIVATE_KEY=
ETHERSCAN_API_KEY=
