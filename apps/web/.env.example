# Base Mainnet RPC (public fallback used when unset)
NEXT_PUBLIC_BASE_RPC_URL=https://mainnet.base.org

# Base Sepolia RPC (public fallback used when unset)
NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# WalletConnect Cloud project id (only needed when walletConnect connector is enabled)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Backend API base URL (phase 2). E.g. http://localhost:3001/api/v1
# When unset, the UI shows "quote engine not connected".
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api/v1
