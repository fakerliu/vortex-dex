# ============================================================
# VORTEX DEX API 环境变量示例（复制为 .env 使用，.env 不入库）
# ============================================================

# ---------- 数据库 ----------
# 正式环境（默认）：PostgreSQL 16（Docker 容器 vortex-postgres）
DATABASE_URL="postgresql://vortex:vortex@localhost:5432/vortex?schema=public"

# 本地无 Docker 时的 SQLite 验证（需同时把 schema.prisma 的 provider 改回 "sqlite"，
# 并把金额字段从 Decimal @db.Decimal(78, 0) 改回 String）
# DATABASE_URL="file:./dev.db"

# ---------- 服务端口 ----------
API_PORT=3001
PORT=3001

# ---------- 链上 RPC（可注入覆盖；缺省用 Base 公共 RPC） ----------
# BASE_MAINNET_RPC_URL="https://mainnet.base.org"
# BASE_SEPOLIA_RPC_URL="https://sepolia.base.org"
RPC_TIMEOUT_MS=10000

# ---------- 区块链 Indexer（Sprint 7） ----------
# 后台扫描循环是否随 API 启动自动开启（默认 false，避免公共 RPC 被打满）
# INDEXER_AUTOSTART=true
# 起始区块（可选；缺省用 pools.last_synced_block 的最小值）
# INDEXER_START_BLOCK=53470000
# 备用 RPC 端点池（逗号分隔；缺省用内置公共端点列表）
# INDEXER_RPC_URLS="https://mainnet.base.org,https://base-rpc.publicnode.com"
